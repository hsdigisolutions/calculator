# WordPress calculator-SEO integration (feat/wp-calculator-seo)
# Copy the relevant vars into .env.local (dev) and your Vercel project env (prod).

# WPGraphQL endpoint of the headless CMS.
WORDPRESS_API_URL=https://cms.hscalculadora.com/graphql

# Master switch for the WP fetch on calculator pages (build + runtime).
# Leave unset/false to build without the CMS (pages render from JSON only).
WP_SEO_ENABLED=true

# Shared secret for POST /api/revalidate. Must equal the plugin's
# Calculator Pages -> Settings -> "Revalidate secret". Use a long random string.
REVALIDATE_SECRET=change-me-to-a-long-random-string
