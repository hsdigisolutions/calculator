# Copy to .env.local and fill in. These NEXT_PUBLIC_* values are exposed to the browser.

# Headless WordPress (WPGraphQL) endpoint powering the /blog section.
NEXT_PUBLIC_WP_GRAPHQL_URL=https://cms.hscalculadora.com/graphql

# Public origin, used for canonical URLs, sitemaps and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://calcvora.com
